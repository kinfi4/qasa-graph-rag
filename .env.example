# Google Gemini API key (used for entity extraction, answer generation, and the LLM judge).
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-api-key-here

# Alternatively, to use Vertex AI instead of the Developer API, leave GOOGLE_API_KEY
# unset and provide a base64-encoded service-account JSON:
# GOOGLE_APPLICATION_CREDENTIALS_JSON=base64-encoded-service-account-json

# Neo4j connection (defaults match docker-compose.yml).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
